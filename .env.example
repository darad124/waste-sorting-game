# Used when generating absolute Open Graph/Twitter image URLs during the build.
# Set this to the public URL where the game is deployed.
SHARE_SITE_URL=https://your-ecosort-domain.example

# Supabase — feedback capture & admin dashboard.
# Settings -> API in your Supabase project. The anon key is safe to ship in the browser (RLS protects data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
